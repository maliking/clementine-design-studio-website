{#- One blog or plugin card. Needs `p` (a post from _data/blogPosts.json or pluginPosts.json). -#}
<li class="post-card">
  <a class="post-open" href="{{ p.url }}">
    <div class="post-photo">{% if p.image %}<img src="{{ p.image }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
    <div class="post-text">
      <p class="post-date"><time datetime="{{ p.date }}">{{ p.dateLabel }}</time></p>
      <h3>{{ p.title }}</h3>
      {% if p.summary %}<p class="post-sum">{{ p.summary }}</p>{% endif %}
      <p class="post-more">{{ moreLabel }} <span aria-hidden="true">→</span></p>
    </div>
  </a>
</li>
