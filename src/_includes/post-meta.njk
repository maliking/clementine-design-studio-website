{#- Search and sharing details for one blog post or plugin page, matching what Squarespace published (11/25). -#}
{%- set absUrl = site.url + post.url %}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ absUrl }}">
{% if post.image %}<meta property="og:image" content="{{ site.url }}{{ post.image }}">{% endif %}
<meta property="article:published_time" content="{{ post.published }}">
<meta property="article:modified_time" content="{{ post.modified }}">
<meta property="article:author" content="{{ site.url }}/about">
<meta name="author" content="Mali King">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if post.image %}<meta name="twitter:image" content="{{ site.url }}{{ post.image }}">{% endif %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": absUrl,
  "url": absUrl,
  "headline": post.title,
  "name": title,
  "description": description,
  "image": (site.url + post.image) if post.image else undefined,
  "datePublished": post.published,
  "dateModified": post.modified,
  "author": { "@type": "Person", "@id": site.url + "/#mali", "name": "Mali King", "url": site.url + "/about" },
  "publisher": { "@type": "Organization", "name": site.name, "url": site.url, "logo": { "@type": "ImageObject", "url": site.url + "/assets/img/logo.png" } }
} | dump | safe }}</script>
{%- if post.faq and post.faq.length %}
{#- Optional: a post can list its visible FAQ as `faq: [{q, a}]` in the data file. Keep it word-for-word the same as the FAQ on the page. -#}
{%- set faqItems = [] %}
{%- for f in post.faq %}{% set faqItems = (faqItems.push({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }), faqItems) %}{% endfor %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqItems } | dump | safe }}</script>
{%- endif %}
