<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | {{ site.name }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if preview %}<meta name="robots" content="noindex, nofollow">{% elif noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ canonicalPath or (page.url | replace('/index.html', '')) }}">
{% if postMeta %}{% include "post-meta.njk" %}{% else %}
{#- Sharing preview for pages that aren't posts (posts have their own in post-meta.njk). Added 11/26. -#}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<meta property="og:url" content="{{ site.url }}{{ canonicalPath or (page.url | replace('/index.html', '')) }}">
<meta property="og:image" content="{{ site.url }}{{ shareImage or '/assets/img/share-mali.jpg' }}">
<meta name="twitter:card" content="summary">
{% endif %}
{% include "org-schema.njk" %}
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="preconnect" href="https://p.typekit.net" crossorigin>
{# Headings: IvyPresto Display needs an Adobe Fonts web project from Mali's own Adobe account (see README). Until then a free stand-in loads. #}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap">
<link rel="stylesheet" href="https://use.typekit.net/dfz0hqs.css">
<link rel="stylesheet" href="/assets/css/site.css">
{% if extraCss %}<link rel="stylesheet" href="/assets/css/{{ extraCss }}">{% endif %}
{% if not preview %}
{#- Google Analytics 4 (property "Clementine", hello@maliking.com). Live site only, so previews don't count as visits. Added 11/26.
    Lead tracking: "generate_lead" fires when the contact form's thank-you page opens, and when someone books on the Calendly
    widget on /consultation. Both are marked as key events in GA. -#}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ site.gaId }}');
  {% if leadEvent %}gtag('event', 'generate_lead', { lead_type: '{{ leadEvent }}' });{% endif %}
  window.addEventListener('message', function (e) {
    if (e.origin === 'https://calendly.com' && e.data && e.data.event === 'calendly.event_scheduled') {
      gtag('event', 'generate_lead', { lead_type: 'consultation_booked' });
    }
  });
</script>
{% endif %}
<link rel="stylesheet" href="/assets/css/motion.css">
{#- Motion (Mali picked these five 11/26): switch each idea on with a class, before the page paints. All off for "reduce motion", except hovers, which calm themselves in the CSS. ?m=reveal,hover picks ideas for testing. -#}
<script>(function(){var d=document.documentElement,q=new URLSearchParams(location.search).get('m'),on=q===null?['reveal','hover','pin','layer','depth']:q.split(','),r=matchMedia('(prefers-reduced-motion: reduce)').matches;on.forEach(function(k){if(k&&(k==='hover'||!r))d.classList.add('m-'+k)})})();</script>
</head>
<body>

<header class="site-header">
  <a class="logo" href="/"><img src="/assets/img/logo.png" alt="{{ site.name }}" width="379" height="88"></a>
  <nav class="nav">
    {%- for item in site.nav %}<a href="{{ item.url }}"{% if item.key == nav %} class="on" aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor -%}
  </nav>
  <a class="btn btn-head" href="{{ site.consultUrl }}">Book a Free Consultation</a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu"><span></span></button>
</header>
{#- Phone menu: a full-screen layer over the page (it never pushes the page down). Opens with a circle that grows from the menu button. -#}
<div class="mobile-menu" id="mobile-menu" aria-label="Menu" inert>
  <nav class="mm-links">
    {%- for item in site.nav %}<a href="{{ item.url }}" style="--i: {{ loop.index }}"{% if item.key == nav %} class="on" aria-current="page"{% endif %}><span class="mm-num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span><span class="mm-label">{{ item.label }}</span></a>{% endfor %}
  </nav>
  <div class="mm-foot" style="--i: {{ site.nav.length + 1 }}">
    <a class="btn" href="{{ site.consultUrl }}">Book a Free Consultation</a>
    <img class="mm-badge" src="/assets/img/squarespace-circle-platinum-2026.webp" alt="Squarespace Circle Platinum Partner 2026" width="640" height="219" loading="lazy">
  </div>
</div>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <a class="foot-logo" href="/"><img src="/assets/img/logo.png" alt="{{ site.name }}" width="379" height="88" loading="lazy"></a>
        <a class="circle-badge" href="https://www.squarespace.com/circle" target="_blank" rel="noopener"><img src="/assets/img/squarespace-circle-platinum-2026.webp" alt="Squarespace Circle Platinum Partner 2026" width="640" height="219" loading="lazy"></a>
      </div>
      <nav class="foot-col" aria-label="Pages">
        <p class="foot-h">Pages</p>
        {%- for item in site.nav %}{% if item.key != "home" %}<a href="{{ item.url }}">{{ item.label }}</a>{% endif %}{% endfor %}
      </nav>
      <nav class="foot-col" aria-label="More help">
        <p class="foot-h">More help</p>
        {%- for l in site.footerLinks %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
      </nav>
    </div>
    <div class="foot-bottom">
      <p class="copy">© {{ year }} {{ site.name }}</p>
      <p class="legal"><a href="/privacy-policy">Privacy Policy</a><a href="/cookie-policy">Cookie Policy</a></p>
    </div>
    <p class="disc">Clementine Design Studio is not affiliated, sponsored, or endorsed by Squarespace. The term "Squarespace" is the registered trademark and property of Squarespace, Inc.</p>
  </div>
</footer>

<script>
  (function () {
    var btn = document.querySelector('.menu-btn'), menu = document.getElementById('mobile-menu');
    function setOpen(open) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      if (open) menu.removeAttribute('inert'); else menu.setAttribute('inert', '');
      document.documentElement.classList.toggle('menu-open', open);
    }
    btn.addEventListener('click', function () { setOpen(btn.getAttribute('aria-expanded') !== 'true'); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); } });
    menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    window.addEventListener('resize', function () { if (window.innerWidth > 900 && btn.getAttribute('aria-expanded') === 'true') setOpen(false); });
  })();

  // Scroll animation. Same-page links (like the "What do you need help with?" cards) glide down instead of jumping,
  // and content fades up once as it scrolls into view. Both are off for people who turn on "reduce motion".
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var root = document.documentElement;

    function ease(t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
    var raf = null;
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = null; } }
    ['wheel', 'touchstart', 'keydown'].forEach(function (ev) { window.addEventListener(ev, stop, { passive: true }); });

    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest('a[href^="#"]');
      if (!a) return;
      var id = decodeURIComponent(a.getAttribute('href').slice(1));
      var target = id && document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      var start = window.scrollY;
      var max = document.documentElement.scrollHeight - window.innerHeight;
      var bar = document.querySelector('.svc-nav');
      var off = bar && id !== 'help' ? bar.offsetHeight + 24 : 0;
      var end = Math.min(max, Math.max(0, target.getBoundingClientRect().top + start - off));
      var done = function () {
        history.pushState(null, '', '#' + id);
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      };
      stop();
      if (reduce) { window.scrollTo(0, end); done(); return; }
      var dist = end - start, dur = Math.min(1300, Math.max(600, Math.abs(dist) * 0.4)), t0 = null;
      var step = function (now) {
        if (t0 === null) t0 = now;
        var t = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, start + dist * ease(t));
        if (t < 1) raf = requestAnimationFrame(step); else { raf = null; done(); }
      };
      raf = requestAnimationFrame(step);
    });

    // Services page section bar: show it after the help cards, hide it at the end, and mark the section you're in.
    var nav = document.querySelector('.svc-nav');
    if (nav) {
      var cards = document.getElementById('help');
      var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
      var secs = links.map(function (a) { return document.getElementById(a.getAttribute('href').slice(1)); });
      var lastSec = secs[secs.length - 1];
      var current = null, ticking = false;
      var update = function () {
        ticking = false;
        var y = window.innerHeight * 0.35;
        var show = cards.getBoundingClientRect().bottom < 0 && lastSec.getBoundingClientRect().bottom > y;
        nav.classList.toggle('show', show);
        var on = null;
        secs.forEach(function (sec, i) { var r = sec.getBoundingClientRect(); if (r.top <= y && r.bottom > y) on = links[i]; });
        if (on !== current) {
          if (current) current.classList.remove('on');
          if (on) {
            on.classList.add('on');
            var w = nav.querySelector('.wrap');
            if (w.scrollWidth > w.clientWidth) w.scrollTo({ left: on.offsetLeft - (w.clientWidth - on.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' });
          }
          current = on;
        }
      };
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      window.addEventListener('resize', update);
      update();
      // Arrows at the bar's edges (phone): show which way there's more, and scroll on tap.
      var w = nav.querySelector('.wrap');
      var edges = function () {
        w.classList.toggle('at-start', w.scrollLeft <= 4);
        w.classList.toggle('at-end', w.scrollLeft + w.clientWidth >= w.scrollWidth - 4);
      };
      w.addEventListener('scroll', edges, { passive: true });
      window.addEventListener('resize', edges);
      edges();
      Array.prototype.forEach.call(nav.querySelectorAll('.svc-arrow'), function (btn) {
        btn.addEventListener('click', function () {
          var dir = btn.classList.contains('next') ? 1 : -1;
          w.scrollBy({ left: dir * w.clientWidth * 0.6, behavior: reduce ? 'auto' : 'smooth' });
        });
      });
    }

    if (reduce || !('IntersectionObserver' in window) || root.classList.contains('m-reveal')) return;
    var groups = /(^|\s)(jgroup|jump-grid|pf-grid|help-grid|update-grid|rev-list|steps|kind|plan-grid|hi-grid|start-grid)(\s|$)/;
    function expand(el) {
      if (!groups.test(el.className || '')) return [el];
      var out = [];
      Array.prototype.forEach.call(el.children, function (c) { out = out.concat(expand(c)); });
      return out;
    }
    var sections = document.querySelectorAll('main > section:not(:first-of-type):not(.trust)');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        // Very tall blocks (like the privacy policy) never reach 8% on screen, so also show anything that fills a quarter of the screen.
        if (!en.isIntersecting || (en.intersectionRatio < 0.08 && en.intersectionRect.height < window.innerHeight * 0.25)) return;
        var el = en.target;
        io.unobserve(el);
        el.classList.add('in');
        setTimeout(function () { el.classList.remove('reveal', 'in'); el.style.transitionDelay = ''; }, 900 + (parseFloat(el.style.transitionDelay) || 0) * 1000);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: [0, 0.02, 0.04, 0.08] });
    root.classList.add('js-anim');
    sections.forEach(function (sec) {
      var items = [];
      sec.querySelectorAll(':scope > .wrap, :scope > div > .wrap, :scope > .wrap-wide').forEach(function (w) {
        Array.prototype.forEach.call(w.children, function (c) { items = items.concat(expand(c)); });
      });
      if (!items.length) items = [sec];
      var lastTop = null, n = 0;
      items.forEach(function (el) {
        var top = Math.round(el.getBoundingClientRect().top);
        n = top === lastTop ? n + 1 : 0;
        lastTop = top;
        if (n) el.style.transitionDelay = Math.min(n, 4) * 0.08 + 's';
        el.classList.add('reveal');
        io.observe(el);
      });
    });
  })();
  // Wide tables in posts: round arrow buttons show there's more to the side, and scroll on tap.
  (function () {
    var wraps = document.querySelectorAll('.post-body [class$="table-wrap"]');
    if (!wraps.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var chev = function (d) { return '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="' + (d > 0 ? 'm6 3 5 5-5 5' : 'M10 3 5 8l5 5') + '" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'; };
    Array.prototype.forEach.call(wraps, function (w) {
      var box = document.createElement('div');
      box.className = 'scroll-hint at-start';
      w.parentNode.insertBefore(box, w);
      box.appendChild(w);
      [-1, 1].forEach(function (d) {
        var b = document.createElement('button');
        b.type = 'button';
        b.tabIndex = -1;
        b.className = 'sh-btn ' + (d > 0 ? 'next' : 'prev');
        b.setAttribute('aria-label', d > 0 ? 'Scroll the table right' : 'Scroll the table left');
        b.innerHTML = chev(d);
        b.addEventListener('click', function () { w.scrollBy({ left: d * w.clientWidth * 0.7, behavior: reduce ? 'auto' : 'smooth' }); });
        box.appendChild(b);
      });
      var upd = function () {
        var max = w.scrollWidth - w.clientWidth;
        box.classList.toggle('no-scroll', max <= 4);
        box.classList.toggle('at-start', w.scrollLeft <= 4);
        box.classList.toggle('at-end', w.scrollLeft >= max - 4);
      };
      w.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd);
      upd();
    });
  })();
</script>
{% include "motion.njk" %}
</body>
</html>
