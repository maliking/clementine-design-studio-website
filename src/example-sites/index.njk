---
layout: base.njk
title: "Portfolio | Websites I’ve Built"
description: "A few of the websites Mali King has designed for small businesses, studios, nonprofits and speakers. Scroll through each one on a computer and a phone."
nav: portfolio
permalink: /example-sites/
---
{#- Projects live in src/_data/portfolio.json. Images: /assets/img/portfolio/<slug>/ (card.webp, then the full page cut into
    d-01.webp, d-02.webp... for computer and p-01.webp... for phone; sizes in src/_data/portfolioImages.json).
    Tiles only load when someone opens that project and scrolls near them. "video": true projects also have
    /assets/video/portfolio/<slug>-desktop.mp4 and -phone.mp4. No links to live sites, on purpose: client sites change. -#}

<section class="hero page-hero pf-hero">
  <div class="wrap center-head">
    <div class="eyebrow">Portfolio</div>
    <h1>A few websites I’m <em>proud of</em></h1>
    <p class="lead">Click any project to take a closer look.</p>
  </div>
</section>

<section class="pf-page">
  <div class="wrap">
    <div class="pf-filters" role="group" aria-label="Show projects by type of business">
      <button type="button" aria-pressed="true" data-filter="all">All</button>
      {%- for g in portfolio.groups %}
      <button type="button" aria-pressed="false" data-filter="{{ g.key }}">{{ g.label }}</button>
      {%- endfor %}
    </div>
    <ul class="pf-grid" id="pf-grid">
      {%- set pfHref = "" %}
      {%- for p in portfolio.projects %}
      {% include "pf-card.njk" %}
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <div class="cta-panel">
      <h2>Let’s collaborate &amp; create a website you can’t wait to <em>show your friends and family!</em></h2>
      <p style="margin-top: 36px;"><a class="btn" href="{{ site.consultUrl }}">Book a Free Consultation</a></p>
    </div>
  </div>
</section>

{#- The project viewer. Filled in by the script below from the data in #pf-data. -#}
<dialog class="pf-view" id="pf-view" aria-labelledby="pf-view-name">
  <div class="pf-view-inner">
    <div class="pf-view-head">
      <div>
        <h2 id="pf-view-name"></h2>
        <p class="pf-view-type"></p>
        <p class="pf-tags"></p>
      </div>
      <p class="pf-about"></p>
      <button type="button" class="pf-close" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>

    <div class="pf-controls">
      <div class="pf-switch pf-mode" role="group" aria-label="Video or still page">
        <button type="button" aria-pressed="true" data-mode="video">Watch it move</button>
        <button type="button" aria-pressed="false" data-mode="still">Scroll it yourself</button>
      </div>
      <div class="pf-switch pf-screen" role="group" aria-label="Choose a screen size">
        <button type="button" aria-pressed="true" data-screen="desktop">Computer</button>
        <button type="button" aria-pressed="false" data-screen="phone">Phone</button>
      </div>
    </div>

    <div class="pf-stage">
      <div class="pf-desktop">
        <div class="pf-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="pf-scroll" tabindex="0" aria-label="Full page on a computer. Scroll to see more."></div>
        <video class="pf-video" muted loop playsinline preload="none" aria-label="Video of the home page scrolling on a computer"></video>
      </div>
      <div class="pf-mock"><img alt=""></div>
      <aside class="pf-side">
        <div class="pf-phone">
          <div class="pf-scroll" tabindex="0" aria-label="Full page on a phone. Scroll to see more."></div>
          <video class="pf-video" muted loop playsinline preload="none" aria-label="Video of the home page scrolling on a phone"></video>
        </div>
        <p class="pf-hint"></p>
      </aside>
    </div>

    <div class="pf-view-foot">
      <button type="button" class="pf-step" data-step="-1"><span aria-hidden="true">←</span> Previous</button>
      <button type="button" class="pf-step" data-step="1">Next project <span aria-hidden="true">→</span></button>
    </div>
  </div>
</dialog>

<script type="application/json" id="pf-data">{{ portfolio.projects | dump | safe }}</script>
<script type="application/json" id="pf-images">{{ portfolioImages | dump | safe }}</script>
<script>
(function () {
  var data = JSON.parse(document.getElementById('pf-data').textContent);
  var images = JSON.parse(document.getElementById('pf-images').textContent);
  var bySlug = {};
  data.forEach(function (p) { p.img = images[p.slug] || null; bySlug[p.slug] = p; });
  var grid = document.getElementById('pf-grid');
  var view = document.getElementById('pf-view');
  var root = document.documentElement;
  var base = function (p) { return '/assets/img/portfolio/' + p.slug + '/'; };
  var vid = function (p, kind) { return '/assets/video/portfolio/' + p.slug + '-' + kind + '.mp4'; };
  var current = null;
  var narrow = window.matchMedia('(max-width: 900px)');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Filters
  var filterBtns = document.querySelectorAll('.pf-filters button');
  filterBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      var f = b.getAttribute('data-filter');
      filterBtns.forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
      grid.querySelectorAll('.pf-card').forEach(function (c) {
        c.hidden = f !== 'all' && c.getAttribute('data-group') !== f;
      });
    });
  });

  // The full page comes in slices. Each slice loads when it's close to being scrolled into view.
  var observers = [];
  function fillTiles(scroller, p, kind) {
    var info = p.img && p.img[kind];
    scroller.innerHTML = '';
    if (!info) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        var im = en.target; io.unobserve(im);
        im.src = im.getAttribute('data-src');
      });
    }, { root: scroller, rootMargin: '1800px 0px' });
    observers.push(io);
    info.tiles.forEach(function (h, i) {
      var im = document.createElement('img');
      im.width = info.w; im.height = h; im.alt = i === 0 ? 'The whole ' + p.name + ' home page on a ' + (kind === 'desktop' ? 'computer' : 'phone') : '';
      im.decoding = 'async';
      var src = base(p) + kind.charAt(0) + '-' + String(i + 1).padStart(2, '0') + '.webp';
      im.onload = function () { im.classList.add('ready'); };
      if (i < 2) im.src = src; else { im.setAttribute('data-src', src); io.observe(im); }
      scroller.appendChild(im);
    });
  }

  // Start loading the first slices as soon as someone hovers or focuses a card
  var warmed = {};
  function warm(p) {
    if (!p || !p.img || warmed[p.slug]) return;
    warmed[p.slug] = true;
    ['desktop', 'phone'].forEach(function (k) {
      if (p.img[k]) (new Image()).src = base(p) + k.charAt(0) + '-01.webp';
    });
  }

  function pressed(sel, attr, val) {
    view.querySelectorAll(sel + ' button').forEach(function (b) {
      b.setAttribute('aria-pressed', b.getAttribute(attr) === val ? 'true' : 'false');
    });
  }
  function setScreen(which) { view.setAttribute('data-screen', which); pressed('.pf-screen', 'data-screen', which); playVisible(); }
  function setMode(mode) {
    view.setAttribute('data-mode', mode); pressed('.pf-mode', 'data-mode', mode);
    view.querySelector('.pf-hint').textContent = mode === 'video' ? 'A recording of the real site, so you can see it move.' : 'Scroll inside each screen to see the whole page.';
    playVisible();
  }
  view.querySelectorAll('.pf-screen button').forEach(function (b) { b.addEventListener('click', function () { setScreen(b.getAttribute('data-screen')); }); });
  view.querySelectorAll('.pf-mode button').forEach(function (b) { b.addEventListener('click', function () { setMode(b.getAttribute('data-mode')); }); });

  function videos() { return Array.prototype.slice.call(view.querySelectorAll('video')); }
  function playVisible() {
    videos().forEach(function (v) {
      var show = view.open && current && current.video && view.getAttribute('data-mode') === 'video' && v.offsetParent !== null;
      if (show) { if (!v.getAttribute('src')) { v.src = v.getAttribute('data-src'); } if (!reduce) { var pr = v.play(); if (pr && pr.catch) pr.catch(function () {}); } }
      else if (!v.paused) v.pause();
    });
  }

  function fill(p) {
    current = p;
    observers.forEach(function (o) { o.disconnect(); }); observers = [];
    var full = !!p.img, phone = !!(p.img && p.img.phone);
    view.classList.toggle('is-full', full);
    view.classList.toggle('has-phone', phone);
    view.classList.toggle('has-video', !!p.video);
    view.querySelector('#pf-view-name').textContent = p.name;
    view.querySelector('.pf-view-type').textContent = p.type;
    view.querySelector('.pf-about').textContent = p.about || '';
    view.querySelector('.pf-about').hidden = !p.about;
    view.querySelector('.pf-view-head .pf-tags').innerHTML = p.tags.map(function (t) { return '<span>' + t + '</span>'; }).join('');
    fillTiles(view.querySelector('.pf-desktop .pf-scroll'), p, 'desktop');
    fillTiles(view.querySelector('.pf-phone .pf-scroll'), p, 'phone');
    view.querySelectorAll('.pf-scroll').forEach(function (s) { s.scrollTop = 0; });
    videos().forEach(function (v) {
      v.pause(); v.removeAttribute('src'); v.load();
      var kind = v.closest('.pf-desktop') ? 'desktop' : 'phone';
      if (p.video) { v.setAttribute('data-src', vid(p, kind)); v.poster = vid(p, kind).replace('.mp4', '.jpg'); }
      else { v.removeAttribute('data-src'); v.removeAttribute('poster'); }
    });
    if (!full) {
      var m = view.querySelector('.pf-mock img');
      m.classList.remove('ready'); m.onload = function () { m.classList.add('ready'); };
      m.alt = 'The ' + p.name + ' website'; m.src = p.card;
    }
    view.setAttribute('data-screen', narrow.matches && phone ? 'phone' : 'desktop');
    pressed('.pf-screen', 'data-screen', view.getAttribute('data-screen'));
    setMode(p.video && !reduce ? 'video' : 'still');
  }

  function visible() {
    return Array.prototype.filter.call(grid.querySelectorAll('.pf-card'), function (c) { return !c.hidden; })
      .map(function (c) { return bySlug[c.querySelector('.pf-open').getAttribute('data-slug')]; });
  }

  function open(slug, push) {
    var p = bySlug[slug];
    if (!p) return;
    if (!view.open) { view.showModal(); root.classList.add('pf-lock'); }
    fill(p);
    playVisible();
    var url = location.pathname + '#' + slug;
    if (push) history.pushState({ pf: slug }, '', url); else history.replaceState({ pf: slug }, '', url);
    view.querySelector('.pf-close').focus({ preventScroll: true });
  }

  function close(fromHistory) {
    if (!view.open) return;
    var slug = current && current.slug;
    videos().forEach(function (v) { v.pause(); });
    view.close();
    root.classList.remove('pf-lock');
    if (!fromHistory) history.replaceState(null, '', location.pathname);
    var card = slug && grid.querySelector('[data-slug="' + slug + '"]');
    if (card) card.focus({ preventScroll: true });
  }

  grid.addEventListener('click', function (e) {
    var a = e.target.closest('.pf-open');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    open(a.getAttribute('data-slug'), true);
  });
  ['mouseover', 'focusin', 'touchstart'].forEach(function (ev) {
    grid.addEventListener(ev, function (e) {
      var a = e.target.closest && e.target.closest('.pf-open');
      if (a) warm(bySlug[a.getAttribute('data-slug')]);
    }, { passive: true });
  });

  view.querySelector('.pf-close').addEventListener('click', function () { close(false); });
  view.addEventListener('cancel', function (e) { e.preventDefault(); close(false); });
  view.addEventListener('click', function (e) { if (e.target === view) close(false); });
  view.querySelectorAll('.pf-step').forEach(function (b) {
    b.addEventListener('click', function () {
      var list = visible();
      var i = list.indexOf(current);
      var next = list[(i + Number(b.getAttribute('data-step')) + list.length) % list.length];
      open(next.slug, false);
      warm(list[(list.indexOf(next) + 1) % list.length]);
    });
  });
  view.addEventListener('keydown', function (e) {
    if (e.target.closest('.pf-scroll')) return;
    if (e.key === 'ArrowRight') view.querySelector('.pf-step[data-step="1"]').click();
    if (e.key === 'ArrowLeft') view.querySelector('.pf-step[data-step="-1"]').click();
  });
  narrow.addEventListener && narrow.addEventListener('change', playVisible);

  window.addEventListener('popstate', function () {
    var slug = location.hash.slice(1);
    if (bySlug[slug]) open(slug, false); else close(true);
  });

  // Links from the home page (/example-sites/#luretik) open that project
  var start = location.hash.slice(1);
  if (bySlug[start]) open(start, false);
})();
</script>
